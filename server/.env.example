# ─────────────────────────────────────────────────────────────────────────────
# SIH26183 — ChainTrace Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to true to use pre-built demo data (no real blockchain or DB needed).
# When true, all API responses are clearly labelled as DEMO.
# Set to false for production / live blockchain mode.
DEMO_MODE=true

# ── Database (MongoDB) ────────────────────────────────────────────────────────
# Required for full DB-backed investigation persistence.
# When DEMO_MODE=true and no DB is available, the system uses in-memory store.
MONGODB_URI=mongodb://localhost:27017/chaintrace
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/chaintrace

# ── JWT Authentication ────────────────────────────────────────────────────────
# MUST be changed in production — use a long random secret.
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=24h

# ── TRON Blockchain Provider — TronGrid ───────────────────────────────────────
# Primary data source for TRON / TRC-20 USDT investigation.
# Register at https://www.trongrid.io/ for a free API key.
# Without a key, TronGrid still works but with strict rate limits.
# Key is sent as HTTP header: TRON-PRO-API-KEY
TRON_API_KEY=
TRONGRID_BASE_URL=https://api.trongrid.io

# ── TRON Secondary Provider — TronScan ────────────────────────────────────────
# Fallback/supplementary data source.
# https://tronscan.org/ — no API key needed for public endpoints.
TRONSCAN_BASE_URL=https://apilist.tronscan.org/api

# ── Ethereum Provider (architecture-ready, not yet activated) ─────────────────
# Used when Ethereum/ERC-20 adapter is enabled.
# Infura: https://infura.io/  |  Alchemy: https://alchemy.com/
ETHEREUM_RPC_URL=
ETHERSCAN_API_KEY=

# ── Bitcoin Provider (architecture-ready, not yet activated) ──────────────────
# Used when Bitcoin adapter is enabled.
# BlockCypher: https://www.blockcypher.com/
BLOCKCYPHER_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS — set to your frontend origin
CORS_ORIGIN=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
